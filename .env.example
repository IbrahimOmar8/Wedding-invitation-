PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPT_KEY=change-me-to-a-different-long-random-string

# Public base URL for absolute links in emails, reminders, OG tags
PUBLIC_URL=http://localhost:3000

# wish-listy backend (https://github.com/IbrahimOmar8/wish-listy-backend)
WISHLISTY_BASE_URL=https://wish-listy-backend.onrender.com

# Optional SMTP for RSVP notifications + reminders (falls back to console log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=WedCard <no-reply@wedcard.app>

# Optional Cloudinary (falls back to local /uploads disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Firebase Cloud Messaging (falls back to console log for push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set to 1 in tests to disable the hourly reminder cron
DISABLE_CRON=
